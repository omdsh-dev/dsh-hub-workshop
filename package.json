{
  "name": "@omdsh/dsh-hub-workshop",
  "version": "0.0.0",
  "private": true,
  "description": "Public DSH Hub Workshop catalog and feed projection",
  "type": "module",
  "scripts": {
    "topic:audit": "node scripts/audit-topic-plugins.mjs",
    "topic:fetch": "node scripts/fetch-topic-snapshot.mjs",
    "topic:apply": "node scripts/apply-topic-plugin-audit.mjs",
    "topic:snapshot": "node scripts/refresh-topic-snapshot.mjs",
    "external:sync": "node scripts/sync-external-evidence.mjs",
    "priority:build": "node scripts/build-verification-priority.mjs",
    "feeds:build": "node scripts/build-install-feeds.mjs",
    "inventory:build": "node scripts/build-verification-inventory.mjs",
    "api:build": "node scripts/build-plugin-api.mjs",
    "intake:check": "node scripts/check-intake.mjs",
    "intake:build": "node scripts/build-intake-queue.mjs",
    "intake:validate": "node scripts/intake.mjs validate",
    "intake:prepare": "node scripts/intake.mjs prepare",
    "intake:evidence": "node scripts/intake.mjs evidence",
    "intake:sync-evidence": "node scripts/sync-harness-evidence.mjs",
    "registry:approve": "node scripts/approve-release.mjs",
    "registry:sign": "node scripts/sign-registry.mjs",
    "intake:issue": "node scripts/prepare-issue-intake.mjs",
    "distribution:intake:issue": "node scripts/prepare-distribution-issue.mjs",
    "distribution:intake:build": "node scripts/build-distribution-intake-queue.mjs",
    "distribution:intake:check": "node scripts/check-distribution-intake.mjs",
    "distribution:approve": "node scripts/approve-distribution.mjs",
    "distributions:build": "node scripts/build-distributions-feed.mjs",
    "harness:plan": "node scripts/harness.mjs plan",
    "harness:evidence": "node scripts/harness.mjs evidence",
    "harness:profile": "node scripts/run-harness-fixture.mjs profile",
    "harness:mcp": "node scripts/run-harness-fixture.mjs mcp",
    "harness:skill": "node scripts/run-harness-fixture.mjs skill",
    "harness:verify": "node scripts/run-harness-fixture.mjs all",
    "baseline:verify": "node scripts/verify-official-baseline.mjs",
    "build": "npm run intake:build && npm run distribution:intake:build && npm run feeds:build && npm run distributions:build && npm run inventory:build && npm run priority:build && npm run api:build && node scripts/build-public-site.mjs",
    "check": "npm run intake:check && npm run distribution:intake:check && npm run build && node --check worker/public.js && node scripts/check-public-site.mjs",
    "test": "node --test",
    "validate": "npm run check && npm test",
    "deploy:dry-run": "npm run build && wrangler deploy -c wrangler.public.jsonc --dry-run --outdir dist",
    "deploy": "npm run validate && npm run registry:sign && wrangler deploy -c wrangler.public.jsonc",
    "market:refresh": "node scripts/refresh-marketplace.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "wrangler": "4.122.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "semver": "^7.7.3"
  }
}
